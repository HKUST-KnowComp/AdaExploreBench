{
  "type": "object",
  "additionalProperties": false,
  "required": ["component_id", "repairs"],
  "properties": {
    "component_id": {"type": "string", "minLength": 1},
    "repairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint_id", "action", "replacement_json"],
        "properties": {
          "constraint_id": {"type": "string", "minLength": 1},
          "action": {"enum": ["replace", "remove", "split"]},
          "replacement_json": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
