  "takeaways": [
    {
      "group": "results",
      "statement": "Proactive and adaptive exploration remains highly challenging for most models.",
      "summary": "All eight models finish below 70% calibrated accuracy. Gemini-3.8-Flash leads at 67.25%, and the gap between exact and calibrated accuracy widens from roughly 2–5 points for the top three models to 8–22 points for the rest, so weaker agents also make more costly mistakes."
    },
    {
      "group": "results",
      "statement": "Greater exploration and verification effort do not necessarily translate into better end-to-end performance across models.",
      "summary": "DeepSeek-V4.1-Flash issues about 24 times as many probes as Llama-3.1-8B, yet its calibrated accuracy trails Gemini-3.8-Flash and GPT-6-Sol. It also performs more post-change re-probes than either model without closing the gap."
    },
    {
      "group": "results",
      "statement": "Adaptation ability distinguishes effective agents more clearly than exploration efforts.",
      "summary": "The four strongest models by calibrated accuracy rank in exactly the same order on Change Recognition, while exploration effort does not separate performance as consistently."
    },
    {
      "group": "analysis",
      "statement": "Removing unannounced rule drift significantly recovers agents' end-to-end outcome.",
      "summary": "The Stationary setting raises calibrated accuracy by as much as 14.7 points for DeepSeek-V4.1-Flash and by 6.2 points on average. The weakest models gain less than one point, so removing drift alone cannot compensate for weak rule learning."
    },
    {
      "group": "analysis",
      "statement": "Agents exploit effectively when sufficient evidence is provided externally.",
      "summary": "Six of seven models improve under Evidence Given, four by more than 15 calibrated-accuracy points. The gains identify proactive evidence acquisition, rather than reasoning from available evidence, as a key bottleneck."
    },
    {
      "group": "analysis",
      "statement": "Effective exploration depends more on explored evidence quality than quantity.",
      "summary": "Forced-Probe lifts mean unique probes from 33.9 to 53.8 and increases re-probing, yet mean calibrated accuracy falls by 2.0 points. More probes do not help when the selected cases are uninformative."
    },
    {
      "group": "error",
      "statement": "Rule Drift causes an immediate performance drop, and no model recovers at last.",
      "summary": "Every model above the random floor loses on average 26.9 calibrated-accuracy points at the first post-change batch. Averaged over the final two batches, all six remain 6.9–19.2 points below their own pre-change plateau."
    },
    {
      "group": "error",
      "statement": "Re-probing provides additional evidence, but successful adaptation also depends on how effectively a model exploit evidence.",
      "summary": "Re-probing correlates with Change Recognition within each model, but the cross-model correlation disappears after normalizing by pre-change exploration. Agents differ in how well they interpret before-and-after observations and revise their hypotheses."
    },
    {
      "group": "error",
      "statement": "Agents tend to settle on incomplete representations of environmental dynamics.",
      "summary": "Precision exceeds recall for both Factor and Change Recognition, and in 36.3% of eligible episodes agents report identical pre- and post-change assessments despite an actual change. Plausible but incomplete rules often go unchallenged."
    },
    {
      "group": "error",
      "statement": "Agents struggle to recognize changes in how existing factors influence outcomes.",
      "summary": "Agents identify both replacements but miss the direction reversal in 17.7% of episodes, compared with only 4.1% for the converse. Updating which factors matter is easier than revising how an existing factor affects the outcome."
    }
  ]
}
